rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: get user data from users collection
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // Helper function: check if user is headmaster of given schoolId
    function isHeadmasterOfSchool(schoolId) {
      return request.auth != null &&
        getUserData().role == 'headmaster' &&
        getUserData().schoolId == schoolId;
    }

    // Helper function: check if user is a teacher of given schoolId
    function isTeacherOfSchool(schoolId) {
      return request.auth != null &&
        getUserData().role == 'teacher' &&
        getUserData().schoolId == schoolId;
    }

    // Schools Collection: Read allowed if user belongs to the school
    match /schools/{schoolId} {
      allow read: if request.auth != null && getUserData().schoolId == schoolId;
      allow write: if isHeadmasterOfSchool(schoolId);
    }

    // Users Collection
    match /users/{userId} {
      allow read: if request.auth != null &&
        (request.auth.uid == userId || getUserData().schoolId == resource.data.schoolId);
      allow write: if request.auth.uid == userId ||
        (getUserData().role == 'headmaster' && getUserData().schoolId == request.resource.data.schoolId);
    }

    // Students Collection: Scoped strictly by schoolId
    match /students/{studentId} {
      allow read: if request.auth != null && getUserData().schoolId == resource.data.schoolId;
      allow write: if isHeadmasterOfSchool(request.resource.data.schoolId) ||
        isHeadmasterOfSchool(resource.data.schoolId);
    }

    // Attendance Records
    match /attendance_records/{recordId} {
      allow read: if request.auth != null;
      allow create: if isTeacherOfSchool(request.resource.data.schoolId) || isHeadmasterOfSchool(request.resource.data.schoolId);
      allow update, delete: if isHeadmasterOfSchool(resource.data.schoolId);
    }

    // Academic Records
    match /academic_records/{recordId} {
      allow read: if request.auth != null;
      allow create, update: if isTeacherOfSchool(request.resource.data.schoolId) || isHeadmasterOfSchool(request.resource.data.schoolId);
      allow delete: if isHeadmasterOfSchool(resource.data.schoolId);
    }

    // Dropout Predictions: Written by ML pipeline or headmaster annotations
    match /dropout_predictions/{studentId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null; // ML backend service or headmaster annotation write-backs
    }

    // Aggregated School Stats: Scoped to schoolId
    match /school_stats/{schoolId} {
      allow read: if request.auth != null && getUserData().schoolId == schoolId;
      allow write: if isHeadmasterOfSchool(schoolId);
    }
  }
}
